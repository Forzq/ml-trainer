# Copy this file to .env. Never commit real API keys.
DEEPGRAM_API_KEY=
# Optional fallback for Deepgram; also works when no Deepgram key is configured.
OPENAI_API_KEY=
# whisper-1 is scheduled to shut down on 2027-02-26; this model can be changed later.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENROUTER_API_KEY=
# Select an available text model in your OpenRouter account.
OPENROUTER_MODEL=
# Optional: a faster model for transcript cleanup. Empty = use OPENROUTER_MODEL.
OPENROUTER_TRANSCRIPTION_MODEL=
# Optional: semantic embeddings instead of the offline hashing baseline.
# Changing the model creates a separate Qdrant collection and reindexes cards.
OPENROUTER_EMBEDDING_MODEL=
# Optional: move from embedded Qdrant to a separate server.
QDRANT_URL=
QDRANT_API_KEY=
# Speech: fish for Fish Audio, system for the built-in Windows voice.
TTS_PROVIDER=fish
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=1db1618b6eaf4571ac7db70e20eb6727
# Free developer model availability depends on Fish Audio. No automatic paid fallback.
FISH_AUDIO_MODEL=s2.1-pro-free
# Lower startup latency; normal prioritizes quality, balanced is the middle ground.
FISH_AUDIO_LATENCY=low
